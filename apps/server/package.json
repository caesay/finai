  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env --include \"../../packages/shared/dist/**\" src/index.ts",
