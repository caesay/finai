    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
