# Copy to .env for local development. The server reads plain environment
# variables, so anything set here must also be set in docker-compose.yml.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Where chat transcripts and (later) the database live. The Docker image sets
# this to /data, which docker-compose mounts from the host.
DATA_DIR=./data

# Model the agent runs on. Unset means the Codex CLI default.
# CODEX_MODEL=gpt-5-codex

# Path to the built web client. Leave unset in development (Vite serves it on
# :5173 and proxies /api here). The Docker image sets it to the bundled dist.
# WEB_DIST=../web/dist

# Directory holding Codex CLI config and OAuth credentials. Authenticate once
# with `codex login` (host) or `docker compose exec -it finai codex login`
# (container); the Codex SDK reuses those credentials, so inference is billed
# to the Codex subscription rather than a separate API key.
# CODEX_HOME=/data/codex
